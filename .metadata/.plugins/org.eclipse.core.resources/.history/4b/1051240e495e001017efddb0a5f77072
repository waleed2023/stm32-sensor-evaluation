#ifndef MOTION_ANALYSIS_IMPROVED_H
#define MOTION_ANALYSIS_IMPROVED_H

#include "motion_analysis.h"
#include "lsm6dsox.h"
#include "angle.h"
#include "uart_comm.h"
#include "stm32u5xx_nucleo.h"
#include "complementary_filter.h"
#include <stdbool.h>
#include <math.h>
#include <stdio.h>

// Empfindlichkeiten und Schwellwerte
#define GYRO_SENSITIVITY_DPS_LSB   0.07f    // 0,07 °/s pro LSB bei ±2000 dps
#define GYRO_DEADBAND_DPS          5.0f     // Deadband für Gyro-Offset-Filterung
#define SLOW_ANGLE_THRESHOLD_DEG   2.0f     // Minimale Neigungsänderung für langsame Bewegung
#define FAST_GYRO_THRESHOLD_DPS    100.0f   // Schwellwert für schnelle Bewegung (°/s)
#define FAST_GYRO_THRESHOLD_RAW    ((int16_t)(FAST_GYRO_THRESHOLD_DPS / GYRO_SENSITIVITY_DPS_LSB))
#define LED_BLINK_PERIOD_MS        100      // Blink-Intervall für schnelle Bewegungen

// Complementary Filter Gewicht
#ifndef CF_ALPHA
#define CF_ALPHA                   0.92f    // Weniger Vertrauen in Gyro, mehr Korrektur durch Accelerometer
#endif

typedef enum {
    STATE_IDLE,
    STATE_SLOW_UP,
    STATE_SLOW_DOWN,
    STATE_FAST_UP,
    STATE_FAST_DOWN
} MotionState;

static MotionState currentState = STATE_IDLE;
static uint32_t    lastBlinkTime = 0;

// Für Complementary Filter
static bool     filterInitialized    = false;
static uint32_t filterLastTimestamp  = 0;
static float    fusedPitch           = 0.0f;

// Gyro-Bias (in °/s), per Software-Kalibrierung initialisiert
static float gyroBiasY = 0.0f;

/**
 * @brief Initialisiert Sensor, Filter und ermittelt Gyro-Bias.
 * @param hi2c I2C-Handle
 * @param basePitch Referenz-Pitch (Ruhezustand)
 */
static inline void Motion_Initialize(I2C_HandleTypeDef *hi2c, float basePitch) {
    // Kalibriere Gyro im Ruhezustand
    gyroBiasY = CalibrateGyroBias(hi2c);

    // Setup Complementary Filter
    ComplementaryFilter_Init(basePitch);
    fusedPitch          = basePitch;
    filterLastTimestamp = HAL_GetTick();
    filterInitialized   = true;
}

/**
 * @brief Ermittelt Bewegungstyp und -richtung basierend auf gefiltertem Pitch und Gyro-Daten.
 *        Optimiert um Bias-Subtraktion, Deadband und verlässliche Fehlerprüfung.
 *
 * @param hi2c Zeiger auf I2C-Handle
 * @param basePitch Referenz-Pitch (Ruhezustand)
 * @param timestamp_ms Laufzeit-Timestamp zur LED-Blinksteuerung
 */
static inline void Motion_Process_Improved(I2C_HandleTypeDef *hi2c, float basePitch, uint32_t timestamp_ms) {
    // FIFO-Zähler
    uint16_t samples = LSM6DSOX_GetFIFOLength(hi2c);
    if (samples == 0) {
        return;
    }

    // Block-Read aller FIFO-Daten
    uint16_t bytes = samples * 7;
    uint8_t  buf[bytes];
    if (HAL_I2C_Mem_Read(hi2c, LSM6DSOX_I2C_ADDR, LSM6DSOX_REG_FIFO_DATA_OUT_L, 1, buf, bytes, HAL_MAX_DELAY) != HAL_OK) {
        // Lese-Fehler, Abbruch
        return;
    }

    // Summenbildung Accelerometer-Pitch und Gyro Y
    float accelSum = 0.0f;
    float gyroSum  = 0.0f;
    uint8_t *p     = buf;
    for (uint16_t i = 0; i < samples; ++i) {
        uint8_t tag = *p++;
        int16_t rawX = (int16_t)((uint16_t)p[1] << 8 | p[0]);
        int16_t rawY = (int16_t)((uint16_t)p[3] << 8 | p[2]);
        int16_t rawZ = (int16_t)((uint16_t)p[5] << 8 | p[4]);
        p += 6;

        // Wenn Accelerometer-Datum
        uint8_t type = tag & 0x1F;
        if (type == 0x02 || type == 0x12) {
            accelSum += Calculate_Pitch(rawX, rawY, rawZ);
        } else {
            gyroSum  += rawY * GYRO_SENSITIVITY_DPS_LSB;
        }
    }
    float avgAccelPitch = accelSum / samples;
    float avgGyroY      = gyroSum  / samples;

    // Gyro-Bias abziehen und Deadband anwenden
    avgGyroY -= gyroBiasY;
    if (fabsf(avgGyroY) < GYRO_DEADBAND_DPS) {
        avgGyroY = 0.0f;
    } else {
        avgGyroY = copysignf(fabsf(avgGyroY) - GYRO_DEADBAND_DPS, avgGyroY);
    }

    // Filter initialisieren, falls erforderlich
    if (!filterInitialized) {
        ComplementaryFilter_Init(avgAccelPitch);
        fusedPitch          = avgAccelPitch;
        filterLastTimestamp = timestamp_ms;
        filterInitialized   = true;
    }

    // Zeitdifferenz berechnen
    float dt = (timestamp_ms - filterLastTimestamp) * 0.001f;
    // Clamp dt auf sinnvollen Bereich (z.B. 1 ms ... 100 ms)
    if (dt < 0.001f) dt = 0.001f;
    if (dt > 0.100f) dt = 0.100f;
    filterLastTimestamp = timestamp_ms;

    // Complementary Filter Update
    float gyroPortion    = fusedPitch + avgGyroY * dt;
    fusedPitch           = CF_ALPHA * gyroPortion + (1.0f - CF_ALPHA) * avgAccelPitch;

    // Differenz zum Basis-Winkel
    float deltaAngle = fusedPitch - basePitch;

    // Bewegungserkennung
    MotionState newState = STATE_IDLE;
    if (fabsf(avgGyroY) >= FAST_GYRO_THRESHOLD_DPS) {
        newState = (avgGyroY > 0) ? STATE_FAST_DOWN : STATE_FAST_UP;
    } else if (fabsf(deltaAngle) >= SLOW_ANGLE_THRESHOLD_DEG) {
        newState = (deltaAngle > 0) ? STATE_SLOW_UP : STATE_SLOW_DOWN;
    }

    // Zustand bei Änderung zurücksetzen und Nachricht ausgeben
    if (newState != currentState) {
        BSP_LED_Off(LED_GREEN);
        BSP_LED_Off(LED_RED);
        lastBlinkTime = timestamp_ms;
        switch (newState) {
            case STATE_SLOW_UP:    printf("Langsame Bewegung nach oben\n"); break;
            case STATE_SLOW_DOWN:  printf("Langsame Bewegung nach unten\n"); break;
            case STATE_FAST_UP:    printf("Schnelle Bewegung nach oben\n"); break;
            case STATE_FAST_DOWN:  printf("Schnelle Bewegung nach unten\n"); break;
            default: break;
        }
    }

    // LED-Steuerung
    switch (newState) {
        case STATE_SLOW_UP:
            BSP_LED_On(LED_GREEN);
            break;
        case STATE_SLOW_DOWN:
            BSP_LED_On(LED_RED);
            break;
        case STATE_FAST_UP:
            if ((timestamp_ms - lastBlinkTime) >= LED_BLINK_PERIOD_MS) {
                BSP_LED_Toggle(LED_GREEN);
                lastBlinkTime = timestamp_ms;
            }
            break;
        case STATE_FAST_DOWN:
            if ((timestamp_ms - lastBlinkTime) >= LED_BLINK_PERIOD_MS) {
                BSP_LED_Toggle(LED_RED);
                lastBlinkTime = timestamp_ms;
            }
            break;
        default:
            break;
    }
    currentState = newState;

    // Telemetrie-Ausgabe
    SendToPython(fusedPitch, deltaAngle, avgGyroY);
}

#endif // MOTION_ANALYSIS_IMPROVED_H
