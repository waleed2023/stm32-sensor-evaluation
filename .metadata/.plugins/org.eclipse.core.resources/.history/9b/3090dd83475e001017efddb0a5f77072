/* motion_analysis_optimized.c
 * Verbesserte Version von Motion_Process_Improved mit Optimierungen für Performance,
 * Robustheit und Dynamische Filtergewichtung.
 */
#include "motion_analysis.h"
#include "lsm6dsox.h"
#include "angle.h"
#include "stm32u5xx_nucleo.h"
#include "complementary_filter.h"
#include <stdbool.h>
#include <math.h>
#include <stdio.h>

#define GYRO_SENSITIVITY_DPS_LSB   0.07f    // Sensitivität Gyro ±2000 dps
#define SLOW_ANGLE_THRESHOLD_DEG   4.0f     // Grenze für langsame Bewegung
#define FAST_GYRO_THRESHOLD_DPS    600.0f   // Grenze für schnelle Bewegung
#define GYRO_DEADBAND_DPS          1.0f     // Drift-Unterdrückung
#define DEFAULT_ALPHA              0.97f    // Basis-Filtergewicht
#define GYRO_WEIGHT_THRESHOLD      200.0f   // für dynamisches Alpha
#define LED_BLINK_PERIOD_MS        100      // Blinkrate

// FIFO-Tags (aus Datenblatt)
#define TAG_ACCEL_X       0x01
#define TAG_ACCEL_X_W     0x11
#define TAG_GYRO_Y        0x02
#define TAG_GYRO_Y_W      0x12

#define MAX_FIFO_SAMPLES  256      // maximale Samples zum Puffern
static uint8_t fifoBuf[MAX_FIFO_SAMPLES * 7];

void Motion_Process_Improved(I2C_HandleTypeDef *hi2c,
                             float basePitch,
                             float gyroBias,
                             uint32_t timestamp_ms)
{
    uint16_t samples = LSM6DSOX_GetFIFOLength(hi2c);
    if (samples == 0) return;
    if (samples > MAX_FIFO_SAMPLES) samples = MAX_FIFO_SAMPLES;

    uint16_t bytes = samples * 7;
    HAL_I2C_Mem_Read(hi2c, LSM6DSOX_I2C_ADDR, 0x78, 1, fifoBuf, bytes, HAL_MAX_DELAY);

    // Akkumulieren
    uint32_t accelCount = 0, gyroCount = 0;
    float pitchSum = 0.0f, gyroSum = 0.0f;

    uint8_t *p = fifoBuf;
    for (uint16_t i = 0; i < samples; ++i, p += 7) {
        uint8_t type = (*p) & 0x1F;
        int16_t ax = (int16_t)(p[2] << 8 | p[1]);
        int16_t ay = (int16_t)(p[4] << 8 | p[3]);
        int16_t az = (int16_t)(p[6] << 8 | p[5]);

        switch (type) {
            case TAG_ACCEL_X:
            case TAG_ACCEL_X_W:
                pitchSum  += Calculate_Pitch(ax, ay, az);
                accelCount++;
                break;

            case TAG_GYRO_Y:
            case TAG_GYRO_Y_W: {
                float rate = ay * GYRO_SENSITIVITY_DPS_LSB - gyroBias;
                // Deadband
                float absRate = rate < 0 ? -rate : rate;
                if (absRate > GYRO_DEADBAND_DPS) {
                    gyroSum += rate;
                    gyroCount++;
                }
                break;
            }

            default:
                // Timestamp/Temp ignorieren
                break;
        }
    }

    float avgAccelPitch = (accelCount) ? (pitchSum / accelCount) : 0.0f;
    float avgGyroY      = (gyroCount)  ? (gyroSum  / gyroCount)  : 0.0f;

    static bool filterInit = false;
    static uint32_t lastTs = 0;
    if (!filterInit) {
        ComplementaryFilter_Init(avgAccelPitch);
        lastTs       = timestamp_ms;
        filterInit   = true;
    }

    float dt = (timestamp_ms - lastTs) * 0.001f;
    lastTs = timestamp_ms;

    // Dynamisches Alpha: mehr Gewicht auf Gyro bei schnellen Bewegungen
    float weight = fminf(fabsf(avgGyroY) / GYRO_WEIGHT_THRESHOLD, 1.0f);
    float alpha  = DEFAULT_ALPHA + (1.0f - DEFAULT_ALPHA) * weight;

    float fusedP = ComplementaryFilter_Update_Custom(avgAccelPitch, avgGyroY, dt, alpha);

    float deltaAngle = fusedP - basePitch;

    // Zustandsmaschine
    static MotionState currentState = STATE_IDLE;
    static uint32_t lastBlink = 0;

    bool isFast = (avgGyroY < -FAST_GYRO_THRESHOLD_DPS || avgGyroY > FAST_GYRO_THRESHOLD_DPS);
    bool isSlow = (deltaAngle < -SLOW_ANGLE_THRESHOLD_DEG || deltaAngle > SLOW_ANGLE_THRESHOLD_DEG);

    MotionState newState = STATE_IDLE;
    if (isFast) {
        newState = (deltaAngle > 0) ? STATE_FAST_UP : STATE_FAST_DOWN;
    } else if (isSlow) {
        newState = (deltaAngle > 0) ? STATE_SLOW_UP : STATE_SLOW_DOWN;
    }

    if (newState != currentState) {
        BSP_LED_Off(LED_GREEN);
        BSP_LED_Off(LED_RED);
        lastBlink = timestamp_ms;
        switch (newState) {
            case STATE_SLOW_UP:    printf("Langsame Bewegung nach oben\n");  break;
            case STATE_SLOW_DOWN:  printf("Langsame Bewegung nach unten\n"); break;
            case STATE_FAST_UP:    printf("Schnelle Bewegung nach oben\n");  break;
            case STATE_FAST_DOWN:  printf("Schnelle Bewegung nach unten\n"); break;
            default: break;
        }
        currentState = newState;
    }

    // LED Blink / On
    if (currentState == STATE_SLOW_UP) {
        BSP_LED_On(LED_GREEN);
    } else if (currentState == STATE_SLOW_DOWN) {
        BSP_LED_On(LED_RED);
    } else if (currentState == STATE_FAST_UP) {
        if ((timestamp_ms - lastBlink) >= LED_BLINK_PERIOD_MS) {
            BSP_LED_Toggle(LED_GREEN);
            lastBlink = timestamp_ms;
        }
    } else if (currentState == STATE_FAST_DOWN) {
        if ((timestamp_ms - lastBlink) >= LED_BLINK_PERIOD_MS) {
            BSP_LED_Toggle(LED_RED);
            lastBlink = timestamp_ms;
        }
    }

    printf("FusedPitch=%.1f°, Δ=%.1f°, GyroY=%.1f°/s, State=%d\n",
           fusedP, deltaAngle, avgGyroY, currentState);
    SendToPython(fusedP, deltaAngle, avgGyroY);
}

