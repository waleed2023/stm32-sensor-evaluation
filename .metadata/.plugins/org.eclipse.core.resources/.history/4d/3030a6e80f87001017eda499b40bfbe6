#include "motion_analysis.h"
#include "bmi270.h"
#include "bmi2.h"
#include "angle.h"
#include "uart_comm.h"
#include "stm32u5xx_nucleo.h"
#include "complementary_filter.h"
#include <math.h>
#include <stdbool.h>
#include <stdio.h>

#define GYRO_SENS_DPS_PER_LSB   0.061035f   // BMI270 @ ±2000 dps
#define SLOW_ANGLE_THRES_DEG    5.0f
#define FAST_GYRO_THRES_DPS     300.0f
#define GYRO_DEADBAND_DPS       4.0f
#define LED_BLINK_MS            100

typedef enum { IDLE, SLOW_UP, SLOW_DOWN, FAST_UP, FAST_DOWN } MotionState;
static MotionState state = IDLE;
static uint32_t lastBlink = 0;
static bool initialized = false;
static uint32_t lastTs = 0;
static int printCounter = 0;
// Helper: clamp abs()
static inline float fabsf_clamp(float v, float thr) { return (fabsf(v) < thr) ? 0.0f : v; }

// --- BMI270 FIFO processing with a minimal manual header parser ---
void Motion_Process_270(I2C_HandleTypeDef *hi2c, float basePitch, float gyroBias, uint32_t ts)
{
    (void)hi2c;
    struct bmi2_dev *dev = BMI270_GetDev();
    if (!dev) return;

    static uint8_t fifo_buf[512];
    static struct bmi2_fifo_frame fifo = {0};

    fifo.data          = fifo_buf;
    fifo.length        = 0;
    fifo.header_enable = BMI2_ENABLE;
    fifo.data_enable   = (uint16_t)(BMI2_FIFO_ACC_EN | BMI2_FIFO_GYR_EN);

    fifo.acc_byte_start_idx = 0;
    fifo.gyr_byte_start_idx = 0;
    fifo.aux_byte_start_idx = 0;

    uint16_t fifo_len_dev = 0;
    if (bmi2_get_fifo_length(&fifo_len_dev, dev) != BMI2_OK) return;

    if (fifo_len_dev > sizeof(fifo_buf)) {
        (void)bmi2_set_command_register(BMI2_FIFO_FLUSH_CMD, dev);
        printf("FIFO length absurd (%u) -> flushed\r\n", fifo_len_dev);
        return;
    }

    if (fifo_len_dev < 7) return;

    fifo.length = fifo_len_dev;
    if (bmi2_read_fifo_data(&fifo, dev) != BMI2_OK) return;

    struct bmi2_sens_axes_data acc_m[32], gyr_m[32];
    uint16_t acc_m_len = 0, gyr_m_len = 0;

    uint16_t idx = 0;
    while (idx <= fifo.length) {
        uint8_t h = fifo_buf[idx];

        if (h == 0x8C) {
            if (idx + 13u > fifo.length) break;
            int16_t ax = (int16_t)((uint16_t)fifo_buf[idx+2]  << 8 | fifo_buf[idx+1]);
            int16_t ay = (int16_t)((uint16_t)fifo_buf[idx+4]  << 8 | fifo_buf[idx+3]);
            int16_t az = (int16_t)((uint16_t)fifo_buf[idx+6]  << 8 | fifo_buf[idx+5]);
            int16_t gx = (int16_t)((uint16_t)fifo_buf[idx+8]  << 8 | fifo_buf[idx+7]);
            int16_t gy = (int16_t)((uint16_t)fifo_buf[idx+10] << 8 | fifo_buf[idx+9]);
            int16_t gz = (int16_t)((uint16_t)fifo_buf[idx+12] << 8 | fifo_buf[idx+11]);
            if (acc_m_len < 32) acc_m[acc_m_len++] = (struct bmi2_sens_axes_data){ ax, ay, az };
            if (gyr_m_len < 32) gyr_m[gyr_m_len++] = (struct bmi2_sens_axes_data){ gx, gy, gz };
            idx += 13u;
            continue;
        }
        if (h == 0x84 || h == 0x88) {
            if (idx + 7u > fifo.length) break;
            if (h == 0x84 && acc_m_len < 32) {
                int16_t ax = (int16_t)((uint16_t)fifo_buf[idx+2] << 8 | fifo_buf[idx+1]);
                int16_t ay = (int16_t)((uint16_t)fifo_buf[idx+4] << 8 | fifo_buf[idx+3]);
                int16_t az = (int16_t)((uint16_t)fifo_buf[idx+6] << 8 | fifo_buf[idx+5]);
                acc_m[acc_m_len++] = (struct bmi2_sens_axes_data){ ax, ay, az };
            } else if (h == 0x88 && gyr_m_len < 32) {
                int16_t gx = (int16_t)((uint16_t)fifo_buf[idx+2] << 8 | fifo_buf[idx+1]);
                int16_t gy = (int16_t)((uint16_t)fifo_buf[idx+4] << 8 | fifo_buf[idx+3]);
                int16_t gz = (int16_t)((uint16_t)fifo_buf[idx+6] << 8 | fifo_buf[idx+5]);
                gyr_m[gyr_m_len++] = (struct bmi2_sens_axes_data){ gx, gy, gz };
            }
            idx += 7u;
            continue;
        }
        idx += 1u;
    }

    uint16_t n = (acc_m_len < gyr_m_len) ? acc_m_len : gyr_m_len;
    if (n == 0) return;

    float dt_total = (ts - lastTs) * 1e-3f; if (!initialized) dt_total = 0.0f;
    if ((int32_t)(ts - lastTs) < 0) dt_total = 0.0f;
    float dt_per = (n > 0 && dt_total > 0.0f) ? (dt_total / (float)n) : 0.0f;

    for (uint16_t i = 0; i < n; i++) {
        int16_t ax_i16 = acc_m[i].x;
        int16_t ay_i16 = acc_m[i].y;
        int16_t az_i16 = acc_m[i].z;
        int16_t gy_i16 = gyr_m[i].y;

        float pitchAccel = Calculate_Pitch(ax_i16, ay_i16, az_i16);
        float gyroY_dps  = ((float)gy_i16) * GYRO_SENS_DPS_PER_LSB;
        gyroY_dps = fabsf_clamp(gyroY_dps - gyroBias, GYRO_DEADBAND_DPS);

        if (!initialized) {
            ComplementaryFilter_Init(pitchAccel);
            lastTs      = ts;
            initialized = true;
        }

        float fusedPitch = ComplementaryFilter_Update(pitchAccel, gyroY_dps, dt_per);

        float delta = fusedPitch - basePitch;
        bool  fast  = fabsf(gyroY_dps) >= FAST_GYRO_THRES_DPS;
        bool  slow  = fabsf(delta)     >= SLOW_ANGLE_THRES_DEG;
        MotionState newState = IDLE;

        if (fast)      newState = (delta > 0) ? FAST_UP   : FAST_DOWN;
        else if (slow) newState = (delta > 0) ? SLOW_UP   : SLOW_DOWN;

        if (newState != state) {
            BSP_LED_Off(LED_GREEN);
            BSP_LED_Off(LED_RED);
            lastBlink = ts;
            state     = newState;
        }

        switch (state) {
            case SLOW_UP:   BSP_LED_On(LED_GREEN); break;
            case SLOW_DOWN: BSP_LED_On(LED_RED);   break;
            case FAST_UP:
                if (ts - lastBlink >= LED_BLINK_MS) { BSP_LED_Toggle(LED_GREEN); lastBlink = ts; }
                break;
            case FAST_DOWN:
                if (ts - lastBlink >= LED_BLINK_MS) { BSP_LED_Toggle(LED_RED);   lastBlink = ts; }
                break;
            default: break;
        }

        if (++printCounter >= 20) {
            printCounter = 0;
            printf("FusedPitch=%.1f°, Δ=%.1f°, GyroY=%.1f°/s, State=%d\n",
                   fusedPitch, delta, gyroY_dps, state);
        }}

    lastTs = ts;
}

