#include "bmi270.h"
#include "bmi2.h"
#include "bmi270_maximum_fifo.h"
#include <string.h>
#include <stdio.h>
#include <stdbool.h>

/* --- globaler BMI2-Device-Context --- */
static struct bmi2_dev g_bmi2_dev;
struct bmi2_dev* BMI270_GetDev(void) { return &g_bmi2_dev; }

/* HAL <-> BMI2 Adapter */
static BMI2_INTF_RETURN_TYPE bmi2_hal_read(uint8_t reg, uint8_t *data, uint32_t len, void *intf_ptr)
{
    I2C_HandleTypeDef *hi2c = (I2C_HandleTypeDef*)intf_ptr;
    return (HAL_I2C_Mem_Read(hi2c, BMI270_I2C_ADDR, reg, I2C_MEMADD_SIZE_8BIT,
                             data, len, HAL_MAX_DELAY) == HAL_OK)
           ? BMI2_OK : BMI2_E_COM_FAIL;
}
static BMI2_INTF_RETURN_TYPE bmi2_hal_write(uint8_t reg, const uint8_t *data, uint32_t len, void *intf_ptr)
{
    I2C_HandleTypeDef *hi2c = (I2C_HandleTypeDef*)intf_ptr;
    return (HAL_I2C_Mem_Write(hi2c, BMI270_I2C_ADDR, reg, I2C_MEMADD_SIZE_8BIT,
                              (uint8_t*)data, len, HAL_MAX_DELAY) == HAL_OK)
           ? BMI2_OK : BMI2_E_COM_FAIL;
}
static void bmi2_hal_delay_us(uint32_t period, void *intf_ptr)
{
    (void)intf_ptr;
    HAL_Delay((period + 999U) / 1000U); // µs → ms runden
}

bool BMI270_Init(I2C_HandleTypeDef *hi2c_in)
{
    int8_t r;
    uint8_t v;
    struct bmi2_dev *dev = &g_bmi2_dev;

    // 1) Chip init + Config laden
    r = bmi270_init(dev);
    if (r != BMI2_OK) { printf("ERR bmi270_init=%d\n", (int)r); return false; }

    r = bmi270_load_config(dev);
    if (r != BMI2_OK) { printf("ERR load_config=%d\n", (int)r); return false; }

    // 2) Accelerometer & Gyroscope konfigurieren
    struct bmi2_sens_config cfg[2] = {0};
    uint8_t sens_list[2] = { BMI2_ACCEL, BMI2_GYRO };

    cfg[0].type                = BMI2_ACCEL;
    cfg[0].cfg.acc.odr         = BMI2_ACC_ODR_1600HZ;
    cfg[0].cfg.acc.range       = BMI2_ACC_RANGE_4G;
    cfg[0].cfg.acc.bwp         = BMI2_ACC_NORMAL_AVG4;
    cfg[0].cfg.acc.filter_perf = BMI2_PERF_OPT_MODE;

    cfg[1].type                = BMI2_GYRO;
    cfg[1].cfg.gyr.odr         = BMI2_GYR_ODR_1600HZ;
    cfg[1].cfg.gyr.range       = BMI2_GYR_RANGE_2000;
    cfg[1].cfg.gyr.bwp         = BMI2_GYR_NORMAL_MODE;
    cfg[1].cfg.gyr.noise_perf  = BMI2_PERF_OPT_MODE;
    cfg[1].cfg.gyr.filter_perf = BMI2_PERF_OPT_MODE;

    r = bmi2_set_sensor_config(cfg, 2, dev);
    if (r != BMI2_OK) { printf("ERR set_sensor_config=%d\n", (int)r); return false; }

    // 3) Sensoren einschalten
    r = bmi2_sensor_enable(sens_list, 2, dev);
    if (r != BMI2_OK) { printf("ERR sensor_enable=%d\n", (int)r); return false; }

    // 4) FIFO-Setup
    r = bmi2_set_adv_power_save(BMI2_DISABLE, dev);
    printf("DBG aps_off -> %d\n", (int)r);

    r = bmi2_set_fifo_config(BMI2_FIFO_ALL_EN, BMI2_DISABLE, dev);
    printf("DBG fifo_disable_all -> %d\n", (int)r);

    uint16_t fifo_cfg = (uint16_t)(BMI2_FIFO_HEADER_EN | BMI2_FIFO_ACC_EN | BMI2_FIFO_GYR_EN);
    r = bmi2_set_fifo_config(fifo_cfg, BMI2_ENABLE, dev);
    printf("DBG set_fifo_config -> %d\n", (int)r);
    if (r != BMI2_OK) return false;

    uint16_t rb = 0;
    r = bmi2_get_fifo_config(&rb, dev);
    printf("DBG get_fifo_config = 0x%04X (r=%d)\n", rb, (int)r);

    // Watermark auf 64 Bytes
    v = 64;
    HAL_I2C_Mem_Write(hi2c_in, BMI270_I2C_ADDR, BMI270_REG_FIFO_WTM_0,
                      I2C_MEMADD_SIZE_8BIT, &v, 1, HAL_MAX_DELAY);
    v = 0x00;
    HAL_I2C_Mem_Write(hi2c_in, BMI270_I2C_ADDR, BMI270_REG_FIFO_WTM_1,
                      I2C_MEMADD_SIZE_8BIT, &v, 1, HAL_MAX_DELAY);

    return true;
}

/* (Optional) Legacy-Helpers, falls du mal „roh“ lesen willst */
uint16_t BMI270_GetFIFOLengthBytes(I2C_HandleTypeDef *hi2c)
{
    uint8_t len[2] = {0,0};
    if (HAL_I2C_Mem_Read(hi2c, BMI270_I2C_ADDR, BMI270_REG_FIFO_LEN0,
                         I2C_MEMADD_SIZE_8BIT, len, 2, HAL_MAX_DELAY) != HAL_OK)
        return 0;
    return (uint16_t)len[0] | ((uint16_t)len[1] << 8);
}
bool BMI270_ReadFIFOBytes(I2C_HandleTypeDef *hi2c, uint8_t *dst, uint16_t nbytes)
{
    if (!dst || nbytes == 0) return false;
    return HAL_I2C_Mem_Read(hi2c, BMI270_I2C_ADDR, BMI270_REG_FIFO_DATA,
                            I2C_MEMADD_SIZE_8BIT, dst, nbytes, HAL_MAX_DELAY) == HAL_OK;
}

