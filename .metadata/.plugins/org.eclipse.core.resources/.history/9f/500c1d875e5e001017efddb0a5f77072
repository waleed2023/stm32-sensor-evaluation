#include "motion_analysis.h"
#include "lsm6dsox.h"
#include "angle.h"
#include "uart_comm.h"
#include "stm32u5xx_nucleo.h"
#include "complementary_filter.h"
#include <stdbool.h>
#include <math.h>
#include <stdio.h>

#define GYRO_SENSITIVITY_DPS_LSB   0.07f
#define SLOW_ANGLE_THRESHOLD_DEG   4.0f
#define FAST_GYRO_THRESHOLD_DPS    600.0f
#define GYRO_DEADBAND_DPS          1.0f
#define LED_BLINK_PERIOD_MS       100

#define MAX_FIFO_SAMPLES         256   // schätze auf maximal 256 Samples im FIFO

typedef enum {
    STATE_IDLE,
    STATE_SLOW_UP,
    STATE_SLOW_DOWN,
    STATE_FAST_UP,
    STATE_FAST_DOWN
} MotionState;

static MotionState  currentState      = STATE_IDLE;
static uint32_t     lastBlinkTime     = 0;
static bool         filterInitialized = false;
static uint32_t     filterLastTs      = 0;

void Motion_Process_Improved(I2C_HandleTypeDef *hi2c,
                             float basePitch,
                             float gyroBias,
                             uint32_t timestamp_ms)
{
    // 1) FIFO-Tiefe ermitteln
    uint16_t samples = LSM6DSOX_GetFIFOLength(hi2c);
    if (samples == 0) return;

    // auf MAX_FIFO_SAMPLES beschränken
    if (samples > MAX_FIFO_SAMPLES) samples = MAX_FIFO_SAMPLES;

    // 2) Block-Read aller Samples
    uint8_t buf[MAX_FIFO_SAMPLES * 7];
    if (HAL_I2C_Mem_Read(hi2c, LSM6DSOX_I2C_ADDR, 0x78, 1,
                         buf, samples * 7, HAL_MAX_DELAY) != HAL_OK) {
        return;
    }

    // 3) Summen initialisieren
    uint32_t accelCount = 0, gyroCount = 0;
    float pitchSum = 0.0f, gyroSum = 0.0f;

    // 4) Daten verarbeiten mit Pointer-Arithmetik
    uint8_t *p = buf;
    for (uint16_t i = 0; i < samples; ++i, p += 7) {
        uint8_t  tag  = *p;
        uint8_t  type = tag & 0x1F;
        int16_t  ax   = (int16_t)((p[2] << 8) | p[1]);
        int16_t  ay   = (int16_t)((p[4] << 8) | p[3]);
        int16_t  az   = (int16_t)((p[6] << 8) | p[5]);

        switch (type) {
            case 0x01:  // Accelerometer
            case 0x11:
                pitchSum  += Calculate_Pitch(ax, ay, az);
                accelCount++;
                break;
            case 0x02:  // Gyro Y
            case 0x12:
                gyroSum   += ay * GYRO_SENSITIVITY_DPS_LSB;
                gyroCount++;
                break;
            default:
                break;
        }
    }

    // 5) Mittelwerte (Division als Multiplikation mit Kehrwert)
    float avgAccelPitch = (accelCount > 0) ? (pitchSum * (1.0f / accelCount)) : 0.0f;
    float avgGyroY_raw  = (gyroCount  > 0) ? (gyroSum  * (1.0f / gyroCount))  : 0.0f;

    // 6) Bias und Deadband
    float avgGyroY = avgGyroY_raw - gyroBias;
    if (fabsf(avgGyroY) < GYRO_DEADBAND_DPS) avgGyroY = 0.0f;

    // 7) Filter initialisieren
    if (!filterInitialized) {
        ComplementaryFilter_Init(avgAccelPitch);
        filterLastTs      = timestamp_ms;
        filterInitialized = true;
    }

    // 8) Filter-Update
    float dt         = (timestamp_ms - filterLastTs) * 0.001f;
    filterLastTs     = timestamp_ms;
    float fusedPitch = ComplementaryFilter_Update(avgAccelPitch, avgGyroY, dt);

    // 9) Winkelabweichung + Zustandslogik
    float deltaAngle = fusedPitch - basePitch;
    bool  isFast     = fabsf(avgGyroY) >= FAST_GYRO_THRESHOLD_DPS;
    bool  isSlow     = fabsf(deltaAngle) >= SLOW_ANGLE_THRESHOLD_DEG;

    MotionState newState = STATE_IDLE;
    if (isFast) {
        newState = (deltaAngle > 0) ? STATE_FAST_UP   : STATE_FAST_DOWN;
    } else if (isSlow) {
        newState = (deltaAngle > 0) ? STATE_SLOW_UP   : STATE_SLOW_DOWN;
    }

    // 10) LED & Ausgabe bei Zustandswechsel
    if (newState != currentState) {
        BSP_LED_Off(LED_GREEN);
        BSP_LED_Off(LED_RED);
        lastBlinkTime = timestamp_ms;
        switch (newState) {
            case STATE_SLOW_UP:    printf("Langsame Bewegung nach oben\n");  break;
            case STATE_SLOW_DOWN:  printf("Langsame Bewegung nach unten\n"); break;
            case STATE_FAST_UP:    printf("Schnelle Bewegung nach oben\n");  break;
            case STATE_FAST_DOWN:  printf("Schnelle Bewegung nach unten\n"); break;
            default: break;
        }
        currentState = newState;
    }

    // 11) LED-Steuerung
    switch (currentState) {
        case STATE_SLOW_UP:
            BSP_LED_On(LED_GREEN);
            break;
        case STATE_SLOW_DOWN:
            BSP_LED_On(LED_RED);
            break;
        case STATE_FAST_UP:
            if ((timestamp_ms - lastBlinkTime) >= LED_BLINK_PERIOD_MS) {
                BSP_LED_Toggle(LED_GREEN);
                lastBlinkTime = timestamp_ms;
            }
            break;
        case STATE_FAST_DOWN:
            if ((timestamp_ms - lastBlinkTime) >= LED_BLINK_PERIOD_MS) {
                BSP_LED_Toggle(LED_RED);
                lastBlinkTime = timestamp_ms;
            }
            break;
        default:
            break;
    }

    // 12) Telemetrie
    printf("FusedPitch=%.1f°, Δ=%.1f°, GyroY=%.1f°/s, State=%d\n",
           fusedPitch, deltaAngle, avgGyroY, currentState);
    SendToPython(fusedPitch, deltaAngle, avgGyroY);
}
