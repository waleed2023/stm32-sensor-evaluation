/*
 * bmi270.c — structured like Bosch aux_fifo_full_header_mode.c example
 *
 * This file mirrors the organization of Bosch's DSD example:
 *  - Includes & macros
 *  - Interface glue (read/write/delay)
 *  - Global state (device, fifo, config structs)
 *  - Local helpers to configure sensors, FIFO, and interrupts
 *  - Public init + small readout API
 *
 * Works with STM32 HAL (I2C) and the provided BMI2/BMI270 headers.
 */

#include "bmi270.h"
#include "bmi2.h"
#include "bmi270_maximum_fifo.h"
#include <string.h>
#include <stdio.h>
#include <stdbool.h>

/* ------------------------------------------------------------ */
/* Macros (match example style)                                 */
/* ------------------------------------------------------------ */

/* FIFO water-mark in bytes (tune for your task) */
#ifndef BMI270_FIFO_WM_BYTES
#define BMI270_FIFO_WM_BYTES    (256U)
#endif

/* Timeout helper */
#define MS_TO_US(x)             ((uint32_t)((x) * 1000U))

/* ------------------------------------------------------------ */
/* Interface glue: HAL <-> BMI2                                 */
/* ------------------------------------------------------------ */

static BMI2_INTF_RETURN_TYPE bmi2_hal_read(uint8_t reg, uint8_t *data, uint32_t len, void *intf_ptr)
{
    I2C_HandleTypeDef *hi2c = (I2C_HandleTypeDef*)intf_ptr;
    return (HAL_I2C_Mem_Read(hi2c, BMI270_I2C_ADDR, reg, I2C_MEMADD_SIZE_8BIT, data, len, HAL_MAX_DELAY) == HAL_OK)
           ? BMI2_OK : BMI2_E_COM_FAIL;
}

static BMI2_INTF_RETURN_TYPE bmi2_hal_write(uint8_t reg, const uint8_t *data, uint32_t len, void *intf_ptr)
{
    I2C_HandleTypeDef *hi2c = (I2C_HandleTypeDef*)intf_ptr;
    return (HAL_I2C_Mem_Write(hi2c, BMI270_I2C_ADDR, reg, I2C_MEMADD_SIZE_8BIT, (uint8_t*)data, len, HAL_MAX_DELAY) == HAL_OK)
           ? BMI2_OK : BMI2_E_COM_FAIL;
}

static void bmi2_hal_delay_us(uint32_t period, void *intf_ptr)
{
    (void)intf_ptr;
    /* HAL_Delay is ms; round up */
    HAL_Delay((period + 999U) / 1000U);
}

/* ------------------------------------------------------------ */
/* Global state (like in the Bosch example)                     */
/* ------------------------------------------------------------ */

static struct bmi2_dev g_dev;                  /* Device context */
static struct bmi2_sens_config g_sens_cfg[2];  /* ACC + GYR */
static uint8_t g_sens_list[2] = { BMI2_ACCEL, BMI2_GYRO };

static uint8_t g_fifo_data[2048];              /* Raw FIFO buffer */
static struct bmi2_fifo_frame g_fifo = {
    .data  = g_fifo_data,
    .length = sizeof(g_fifo_data),
    .sensor_time_enable = BMI2_DISABLE,
    .stop_on_full_en = BMI2_DISABLE,
    .fifo_header_en = BMI2_ENABLE,
    .acc_en = BMI2_ENABLE,
    .gyr_en = BMI2_ENABLE,
    .aux_en = BMI2_DISABLE
};

/* ------------------------------------------------------------ */
/* Local helpers                                                 */
/* ------------------------------------------------------------ */

static int8_t set_accel_config(void)
{
    /* Configure ACC: 1600Hz, normal bandwidth, perf mode = perf, range = 2g */
    g_sens_cfg[0].type = BMI2_ACCEL;
    g_sens_cfg[0].cfg.acc.odr  = BMI2_ACC_ODR_1600HZ;
    g_sens_cfg[0].cfg.acc.bwp  = BMI2_ACC_OSR2_AVG2;
    g_sens_cfg[0].cfg.acc.filter_perf = BMI2_PERF_OPT_MODE;
    g_sens_cfg[0].cfg.acc.range = BMI2_ACC_RANGE_2G;
    return bmi2_set_sensor_config(&g_sens_cfg[0], 1, &g_dev);
}

static int8_t set_gyro_config(void)
{
    /* Configure GYR: 1600Hz, normal bandwidth, perf, range = 2000 dps */
    g_sens_cfg[1].type = BMI2_GYRO;
    g_sens_cfg[1].cfg.gyr.odr  = BMI2_GYR_ODR_1600HZ;
    g_sens_cfg[1].cfg.gyr.bwp  = BMI2_GYR_OSR2_MODE;
    g_sens_cfg[1].cfg.gyr.filter_perf = BMI2_PERF_OPT_MODE;
    g_sens_cfg[1].cfg.gyr.range = BMI2_GYR_RANGE_2000;
    g_sens_cfg[1].cfg.gyr.noise_perf = BMI2_GYR_PERF_MODE;
    return bmi2_set_sensor_config(&g_sens_cfg[1], 1, &g_dev);
}

static int8_t enable_sensors(void)
{
    return bmi2_sensor_enable(g_sens_list, 2, &g_dev);
}

static int8_t configure_fifo(uint16_t wm_bytes)
{
    int8_t rslt;

    /* Disable FIFO while configuring */
    uint8_t fifo_conf = 0;
    rslt = bmi2_set_regs(BMI2_FIFO_CONFIG_1_ADDR, &fifo_conf, 1, &g_dev);
    if (rslt != BMI2_OK) return rslt;

    /* Header mode + enable ACC+GYR frames */
    fifo_conf = BMI2_SET_BITS(fifo_conf, BMI2_FIFO_HEADER_EN, BMI2_ENABLE);
    fifo_conf = BMI2_SET_BITS(fifo_conf, BMI2_FIFO_ACC_EN,    BMI2_ENABLE);
    fifo_conf = BMI2_SET_BITS(fifo_conf, BMI2_FIFO_GYR_EN,    BMI2_ENABLE);
    rslt = bmi2_set_regs(BMI2_FIFO_CONFIG_1_ADDR, &fifo_conf, 1, &g_dev);
    if (rslt != BMI2_OK) return rslt;

    /* Watermark */
    uint8_t wtm[2];
    wtm[0] = (uint8_t)(wm_bytes & 0xFF);
    wtm[1] = (uint8_t)((wm_bytes >> 8) & 0x03);
    rslt = bmi2_set_regs(BMI2_FIFO_WTM_0_ADDR, wtm, 2, &g_dev);
    if (rslt != BMI2_OK) return rslt;

    /* Finally enable FIFO */
    uint8_t fifo_conf0 = 0U; /* no downsampling */
    rslt = bmi2_set_regs(BMI2_FIFO_CONFIG_0_ADDR, &fifo_conf0, 1, &g_dev);
    return rslt;
}

/* Optional: map FIFO watermark to INT1 like the example style */
static int8_t configure_interrupts(void)
{
    int8_t rslt;
    struct bmi2_int_pin_config int_pin = {0};

    int_pin.pin_type = BMI2_INT1;
    int_pin.pin_cfg.output_en = BMI2_ENABLE;
    int_pin.pin_cfg.lvl = BMI2_INT_ACTIVE_HIGH;
    int_pin.pin_cfg.input_en = BMI2_DISABLE;
    int_pin.pin_cfg.od = BMI2_INT_PUSH_PULL;
    int_pin.pin_cfg.latch = BMI2_INT_NON_LATCH;
    rslt = bmi2_set_int_pin_config(&int_pin, &g_dev);
    if (rslt != BMI2_OK) return rslt;

    uint8_t int_map = 0;
    int_map = BMI2_SET_BITS(int_map, BMI2_INT_FWM, BMI2_ENABLE);
    return bmi2_set_regs(BMI2_INT_MAP_DATA_ADDR, &int_map, 1, &g_dev);
}

/* ------------------------------------------------------------ */
/* Public API                                                   */
/* ------------------------------------------------------------ */

bool BMI270_Init(I2C_HandleTypeDef *hi2c)
{
    int8_t rslt;

    memset(&g_dev, 0, sizeof(g_dev));
    g_dev.intf     = BMI2_I2C_INTF;
    g_dev.read     = bmi2_hal_read;
    g_dev.write    = bmi2_hal_write;
    g_dev.delay_us = bmi2_hal_delay_us;
    g_dev.intf_ptr = hi2c;

    /* 0) Basic init + chip-id check */
    rslt = bmi2_sec_init(&g_dev);
    if (rslt != BMI2_OK) return false;

    /* 1) Load configuration like in example */
    rslt = bmi270_maximum_fifo_init(&g_dev);
    if (rslt != BMI2_OK) return false;

    /* 2) Power config — disable APS for streaming consistency */
    uint8_t pwr_conf = 0x00; /* adv power save off */
    rslt = bmi2_set_regs(BMI2_PWR_CONF_ADDR, &pwr_conf, 1, &g_dev);
    if (rslt != BMI2_OK) return false;
    g_dev.delay_us(MS_TO_US(2), g_dev.intf_ptr);

    /* 3) Configure sensors */
    if (set_accel_config() != BMI2_OK) return false;
    if (set_gyro_config()  != BMI2_OK) return false;

    /* 4) Enable sensors */
    if (enable_sensors()   != BMI2_OK) return false;

    /* 5) FIFO header mode + watermark */
    if (configure_fifo(BMI270_FIFO_WM_BYTES) != BMI2_OK) return false;

    /* 6) Optional interrupt mapping (can be skipped if polling) */
    (void)configure_interrupts();

    return true;
}

struct bmi2_dev* BMI270_GetDev(void)
{
    return &g_dev;
}

uint16_t BMI270_GetFIFOLengthBytes(I2C_HandleTypeDef *hi2c)
{
    (void)hi2c; /* device is already bound in g_dev */
    uint8_t len_regs[2] = {0};
    if (bmi2_get_regs(BMI2_FIFO_LENGTH_0_ADDR, len_regs, 2, &g_dev) != BMI2_OK)
        return 0;
    return (uint16_t)((((uint16_t)len_regs[1] & 0x07U) << 8) | len_regs[0]);
}

bool BMI270_ReadFIFOBytes(I2C_HandleTypeDef *hi2c, uint8_t *dst, uint16_t nbytes)
{
    (void)hi2c;
    if ((dst == NULL) || (nbytes == 0)) return false;
    return (bmi2_get_regs(BMI2_FIFO_DATA_ADDR, dst, nbytes, &g_dev) == BMI2_OK);
}

/* High-level helper: fetch & parse FIFO like example's main loop */
int BMI270_ReadAndParse(struct bmi2_sens_axes_data *acc, uint16_t *acc_frames,
                        struct bmi2_sens_axes_data *gyr, uint16_t *gyr_frames)
{
    int8_t rslt;

    /* Refresh FIFO length */
    uint16_t fifo_len = BMI270_GetFIFOLengthBytes(NULL);
    if (fifo_len == 0) return BMI2_E_COM_FAIL;

    if (fifo_len > g_fifo.length) fifo_len = g_fifo.length; /* clamp */

    rslt = bmi2_get_regs(BMI2_FIFO_DATA_ADDR, g_fifo.data, fifo_len, &g_dev);
    if (rslt != BMI2_OK) return rslt;
    g_fifo.length = fifo_len;

    /* Parse ACC */
    if ((acc != NULL) && (acc_frames != NULL))
    {
        uint16_t req = *acc_frames;
        rslt = bmi2_extract_accel(acc, &req, &g_fifo, &g_dev);
        if (rslt == BMI2_OK) *acc_frames = req; else return rslt;
    }

    /* Parse GYR */
    if ((gyr != NULL) && (gyr_frames != NULL))
    {
        uint16_t req = *gyr_frames;
        rslt = bmi2_extract_gyro(gyr, &req, &g_fifo, &g_dev);
        if (rslt == BMI2_OK) *gyr_frames = req; else return rslt;
    }

    return BMI2_OK;
}

